#!/usr/bin/env bash
# Runs the unit tests. Fails closed when dependencies are missing.

set -euo pipefail

REPO_ROOT="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../..")"
cd "$REPO_ROOT"

if [ ! -x node_modules/.bin/vitest ]; then
	echo "unit: dependencies are not installed — run npm install (failing closed)" >&2
	exit 1
fi

echo "==> vitest"
npm test
echo "    ok: vitest"
